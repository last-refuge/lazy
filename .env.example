# Copy to .env next to docker-compose.yml and fill it in:   cp .env.example .env
# Generate each secret with:   openssl rand -hex 24

# The database password (hex or letters and digits only: it is placed in a URL).
POSTGRES_PASSWORD=

# The first account can only be created with this code (at least 16 characters). Type it into the
# "Invitation or setup code" field when you create the owner account; it does nothing afterwards.
LAZY_SETUP_CODE=

# The address clients reach the server at, shown in incoming-webhook URLs. With a reverse proxy in
# front, use its public https:// address.
LAZY_PUBLIC_URL=http://localhost:8080

# Who may create an account on the workspace the server creates: invite_only (recommended; the
# owner invites people) or open (anyone who can reach the server).
LAZY_SEED_REGISTRATION=invite_only

# The port published on this machine (the container always listens on 8080).
LAZY_PORT=8080

# Optional: a prebuilt image instead of building here (see llm-docs/DEPLOY.md), and tuning.
# LAZY_IMAGE=ghcr.io/last-refuge/lazy/server:latest
# LAZY_EVENT_RETENTION_DAYS=30
# LAZY_MAX_ATTACHMENT_BYTES=26214400
# LAZY_OPEN_WORKSPACE_CREATION=true
# LAZY_LOG=info,sqlx=warn
# LAZY_LOG_FORMAT=text
